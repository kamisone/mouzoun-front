NUXT_API_INTERNAL_BASE=http://localhost:8080
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3001

# Default social sharing image, absolute URL (empty: pages without their own image share none)
NUXT_PUBLIC_OG_IMAGE=
# true: serve /_styleguide without staff login outside dev (CI accessibility checks only)
NUXT_PUBLIC_STYLEGUIDE=
# Build time: image hosts @nuxt/image may optimise, comma-separated. Never empty.
NUXT_IMAGE_DOMAINS=storage.googleapis.com
